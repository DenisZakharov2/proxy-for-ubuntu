[Unit]
Description=proxy-for-ubuntu routing daemon
Documentation=man:proxy-for-ubuntu(8)
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=proxy-for-ubuntu
ExecStartPre=/usr/bin/proxy-for-ubuntud --check --strict
ExecStart=/usr/bin/proxy-for-ubuntud --daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3

# Каждое перехваченное соединение занимает два сокета (клиент + upstream).
# Дефолт systemd (1024) выбирается браузером за секунды: демон получает
# EMFILE и перестаёт принимать соединения.
LimitNOFILE=65536

# Демон сам пишет файлы с секретами: профили пользователей, реестр подписок,
# точки отката. При умолчании 0022 они создавались бы 0644 и были бы читаемы
# любому локальному пользователю. `REQ-013`.
UMask=0077

# Сетевой демон не должен уметь ничего, кроме unix-сокета IPC, IPv4/IPv6
# (перехват, DNS, outbound'ы) и netlink (nftables, маршруты).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Демон управляет сетевым стеком, поэтому NeedsCapabilities. Остальные
# Capabilities у него нет: никаких файловых или процессных операций.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE CAP_SYS_RESOURCE
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/proxy-for-ubuntu /var/log/proxy-for-ubuntu /run/proxy-for-ubuntu /etc/proxy-for-ubuntu
RuntimeDirectory=proxy-for-ubuntu
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
