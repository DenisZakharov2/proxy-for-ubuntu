{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "proxy-for-ubuntu",
  "version": "0.1.0",
  "identifier": "com.deniszakharov.proxyforubuntu",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "proxy-for-ubuntu",
        "width": 1280,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.png"]
  }
}
